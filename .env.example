# --- Backend (Python) ---
DEBUG=false
PUBLIC_BASE_URL=https://traveltech-backend.onrender.com

# Database (SQLite default; PostgreSQL example below)
DATABASE_URL=sqlite+aiosqlite:///./data/traveltech.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/traveltech

# Локально без установки Redis (ВНИМАНИЕ: сессии живут только в памяти процесса —
# любой перезапуск uvicorn/--reload мгновенно "разлогинивает" все активные киоски):
REDIS_URL=memory://
# Продакшен / Ubuntu-киоск — сессии переживают перезапуск бэкенда:
# sudo apt update && sudo apt install -y redis-server
# sudo systemctl enable --now redis-server
# redis-cli ping   # должно вернуть PONG
# REDIS_URL=redis://127.0.0.1:6379/0

# Kiosk PIN codes — Технологии путешествий (default agency)
KIOSK_PIN_POPOVA=1234
KIOSK_PIN_LOBACHEVSKY=5678
KIOSK_PIN_ROBOT=9012
KIOSK_PIN_RAMEEVA=3456

# Уматур
KIOSK_PIN_UMATOUR_POPOVA=7101
KIOSK_PIN_UMATOUR_LOBACHEVSKY=7102
KIOSK_PIN_UMATOUR_ROBOT=7103
KIOSK_PIN_UMATOUR_RAMEEVA=7104

# Иннотрэвел
KIOSK_PIN_INNOTRAVEL_POPOVA=8101
KIOSK_PIN_INNOTRAVEL_LOBACHEVSKY=8102
KIOSK_PIN_INNOTRAVEL_ROBOT=8103
KIOSK_PIN_INNOTRAVEL_RAMEEVA=8104

# Google GenAI (used by ai_services.py)
GEMINI_API_KEY=your_key_here

# Black Forest Labs FLUX — 2-й шаг каскада картинок (нейростилист / ИИ-творец)
FLUX_TOKEN=
# FLUX_ENDPOINT=https://api.bfl.ai/v1/flux-2-klein-4b
# Каскад: gemini-2.5 → flux → gemini-3.1 (пусто = авто, если есть FLUX_TOKEN)
# IMAGE_PROVIDER_CHAIN=gemini:gemini-2.5-flash-image,flux:flux-2-klein-4b,gemini:gemini-3.1-flash-image
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_MODEL_FALLBACKS=gemini-3.1-flash-image
# GEMINI_VIDEO_MODEL=veo-3.1-lite-generate-preview
# GEMINI_VIDEO_MODEL_FALLBACKS=veo-3.1-generate-preview

# Telegram sticker pack (Стикерпак на киоске + bot.py CLI)
# Telegram-стикерпак (экран «Стикерпак»). После изменения — перезапустите uvicorn.
# TELEGRAM_STICKER_OWNER_ID — числовой Telegram user id владельца набора (узнать: @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_STICKER_OWNER_ID=
# TELEGRAM_BOT_USERNAME=inno_sticker_bot
# TELEGRAM_STICKER_PACK_TITLE=TravelTech — эмоции

# Успешные генерации (фото/видео) — append в файл, время MSK
# GENERATION_LOG_PATH=data/generations.log
# Единый лог событий приложения (JSONL): авторизация, статусы генераций
# APP_EVENTS_LOG_PATH=data/app_events.jsonl

# --- Frontend (Vite) ---
# Обложки стилей: public/static/{neuro_styles,artists}/ — в dist при сборке, с missioninnopolis.ru
# Телефон для QR на рекламной заставке (tel:+7843...)
# VITE_AGENCY_PHONE=+78431234567
# VITE_AGENCY_PHONE_DISPLAY=+7 (843) 123-45-67
# Локально (npm run dev) не задавайте — прокси Vite: /api → http://127.0.0.1:8000
# Продакшен: API и результаты ИИ (/static/results) — только бэкенд:
# VITE_API_URL=https://traveltech-mgig.onrender.com
# Киоск по умолчанию, если нет ?location= в URL
# VITE_KIOSK_ID=Popova
# Экран киоска: http://localhost:5173/?location=Popova
# ИТ-парк Рамеева: ?location=Rameeva
# Страница гида (в QR): http://localhost:5173/guide/auth?location=Popova
